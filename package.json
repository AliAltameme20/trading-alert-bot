{
  "name": "trading-alert-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ai": "^7.0.105",
    "fast-xml-parser": "5.11.1"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/protocol.js && node --check lib/daily.js && node --check scripts/daily.js && node --check scripts/validate.js",
    "signals:preview": "node --env-file=.env.local scripts/daily.js",
    "signals:test-send": "node --env-file=.env.local scripts/daily.js --test --send",
    "validate": "node --env-file=.env.local scripts/validate.js",
    "calibrate": "node scripts/calibrate.js",
    "legacy:morning-preview": "node --env-file=.env.local scripts/morning.js --test"
  },
  "packageManager": "pnpm@10.34.5"
}
